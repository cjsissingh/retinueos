# .env.example — copy to .env and fill in before `docker compose up`
AUTH_PASSWORD=change-me
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Published ports bind to loopback by default. Set HOST_BIND_ADDRESS=0.0.0.0
# only when you intentionally want all three services, including Postgres,
# reachable through every host interface and have secured that exposure.
HOST_BIND_ADDRESS=127.0.0.1

# Optional host-port overrides for running multiple Compose projects on one
# machine. Container ports and service-to-service URLs stay unchanged.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Optional Brave Search API key. When set, personas can be assigned the
# read-only web_search tool for current web and news results. Create a key at
# https://api.search.brave.com/app/keys — keep it server-side and never expose
# it through a NEXT_PUBLIC_* variable.
BRAVE_SEARCH_API_KEY=

# Required to store or read any encrypted integration credential — an MCP
# server's bearer token (see backend/src/tools/mcp-server-repo.ts), added via
# the Connections page at /settings/mcp; see docs/CONNECTORS.md. Generate
# with:
#   openssl rand -base64 32
# Leave unset and MCP server credentials simply can't be stored — everything
# else works fine without it.
CREDENTIALS_ENCRYPTION_KEY=

# The backend's own externally-reachable origin — used to build the OAuth
# redirect URI (${BACKEND_URL}/oauth/callback) for any MCP server connected
# via OAuth (see docs/CONNECTORS.md). Must exactly match whatever redirect
# URI you register with the OAuth provider. Defaults to
# http://localhost:8080, correct for running Docker Compose on your own
# machine.
BACKEND_URL=

# Push notification transport (see backend/src/notifications/notify.ts) —
# a webhook URL that receives a plain-text POST body (the teaser, under 200
# chars). Works as-is against ntfy.sh (e.g. https://ntfy.sh/your-topic-name)
# or a self-hosted ntfy instance. Leave unset and notify() still logs every
# call to the `notifications` table, it just never leaves the box.
NOTIFY_WEBHOOK_URL=

# Standards-based Web Push. Generate a VAPID key pair with
# `npx web-push generate-vapid-keys`; the subject is an operator contact URI.
# All three values are required to enable per-device push enrollment. Leave
# them unset and webhook notifications continue to work independently.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Origin the backend allows via CORS. Must match where the frontend is
# actually served from (browser-visible origin, not a container-internal
# hostname). Defaults to http://localhost:3000, which is correct for
# running Docker Compose on your own machine.
FRONTEND_ORIGIN=http://localhost:3000

# Public URL the browser uses to reach the backend. Defaults to
# http://localhost:8080, which is correct for running Docker Compose
# on your own machine. Change this if you're self-hosting on a server
# reachable at a different host/IP.
#
# NOTE: Next.js inlines NEXT_PUBLIC_* variables into the JS bundle at
# build time, not at container start. Changing this value requires
# `docker compose build frontend` (or `up --build`), not just a restart.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
