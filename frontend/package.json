    "format:check": "prettier --ignore-path ../.prettierignore --check .",
    "knip": "knip"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "autoprefixer": "^10.4.0",
    "knip": "^6.33.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0"
